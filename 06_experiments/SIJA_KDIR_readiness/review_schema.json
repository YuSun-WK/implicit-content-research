{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"K-DIR group after independent review",
 "type":"object",
 "required":["group_id","source_reference","r_a_s","risk_facts","four_cell_outcomes","policy_clause","ambiguity","status","reviewer_ids","review_times_utc","disagreements","gold","er_executable_on_Is","no_other_violations","linkage_verified"],
 "properties":{
  "group_id":{"type":"string"},"source_reference":{"type":"string"},
  "r_a_s":{"type":"object","required":["er","en"],"properties":{"er":{"$ref":"#/$defs/intent"},"en":{"$ref":"#/$defs/intent"}}},
  "risk_facts":{"type":"string"},"four_cell_outcomes":{"type":"object","required":["Iu_er","Iu_en","Is_er","Is_en"]},
  "policy_clause":{"type":"string"},"ambiguity":{"type":"string"},
  "status":{"enum":["SOURCE_LABEL","CODEX_DRAFT","PENDING","HUMAN_VERIFIED","EXCLUDED","UNRESOLVED"]},
  "reviewer_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
  "review_times_utc":{"type":"array","items":{"type":"string","format":"date-time"}},
  "disagreements":{"type":"array"},"gold":{"type":"object","additionalProperties":{"enum":["ALLOW","BLOCK","UNKNOWN"]}},
  "er_executable_on_Is":{"type":"boolean"},"no_other_violations":{"type":"boolean"},"linkage_verified":{"type":"boolean"}
 },
 "$defs":{"intent":{"type":"object","required":["referent","action","specification","instruction_evidence"],"properties":{"referent":{"type":"string"},"action":{"type":"string"},"specification":{"type":"string"},"instruction_evidence":{"type":"string"}}}}
}
